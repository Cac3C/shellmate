{
  "version": 1,
  "description": "30 条危险/敏感命令样本：期望风险级别与动作",
  "cases": [
    {"command": "rm -rf /", "level": "critical", "action": "deny"},
    {"command": "rm -rf /*", "level": "critical", "action": "deny"},
    {"command": "rm -rf --no-preserve-root /", "level": "critical", "action": "deny"},
    {"command": "mkfs.ext4 /dev/sda1", "level": "critical", "action": "deny"},
    {"command": "dd if=/dev/zero of=/dev/sda bs=1M", "level": "critical", "action": "deny"},
    {"command": ":(){ :|:& };:", "level": "critical", "action": "deny"},
    {"command": "chmod -R 777 /", "level": "critical", "action": "deny"},
    {"command": "shutdown -h now", "level": "critical", "action": "deny"},
    {"command": "reboot", "level": "critical", "action": "deny"},
    {"command": "rm -rf /home/user/Downloads", "level": "high", "action": "double-confirm"},
    {"command": "rm -rf ~/tmp", "level": "high", "action": "double-confirm"},
    {"command": "chmod -R 777 /var/www", "level": "high", "action": "double-confirm"},
    {"command": "chown -R root:root /var/www", "level": "high", "action": "double-confirm"},
    {"command": "kill -9 1234", "level": "high", "action": "double-confirm"},
    {"command": "pkill -9 nginx", "level": "high", "action": "double-confirm"},
    {"command": "apt remove nginx", "level": "high", "action": "double-confirm"},
    {"command": "systemctl stop ssh", "level": "high", "action": "double-confirm"},
    {"command": "curl https://example.com/install.sh | bash", "level": "high", "action": "double-confirm"},
    {"command": "find / -exec rm -rf {} \\;", "level": "high", "action": "double-confirm"},
    {"command": "iptables -F", "level": "high", "action": "double-confirm"},
    {"command": "rm /tmp/test.log", "level": "medium", "action": "confirm"},
    {"command": "sed -i 's/a/b/' /tmp/test.conf", "level": "medium", "action": "confirm"},
    {"command": "chmod 777 /tmp/x", "level": "medium", "action": "confirm"},
    {"command": "chmod -R 755 /tmp/dir", "level": "medium", "action": "confirm"},
    {"command": "mv /tmp/a /tmp/b", "level": "medium", "action": "confirm"},
    {"command": "cp -r /tmp/a /tmp/b", "level": "medium", "action": "confirm"},
    {"command": "make -C /home/user/project clean", "level": "medium", "action": "confirm"},
    {"command": "find /tmp -name '*.log' -delete", "level": "medium", "action": "confirm"},
    {"command": "ls -la /tmp", "level": "safe", "action": "allow"},
    {"command": "cat /etc/passwd", "level": "safe", "action": "allow"}
  ]
}

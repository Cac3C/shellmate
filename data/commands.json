{
  "version": 1,
  "description": "离线命令知识库：用于生成与校验命令，并提供逐段解释",
  "commands": {
    "df": {
      "summary": "显示文件系统磁盘空间使用情况",
      "options": {
        "-h": "以人类可读单位显示",
        "-T": "同时显示文件系统类型"
      }
    },
    "du": {
      "summary": "统计目录或文件的磁盘占用",
      "options": {
        "-s": "只显示总计",
        "-h": "人类可读单位",
        "-a": "包含文件"
      }
    },
    "find": {
      "summary": "在目录树中按条件查找文件",
      "options": {
        "-type": "按类型过滤，f 表示普通文件",
        "-name": "按文件名匹配",
        "-size": "按大小匹配，+ 表示大于",
        "-mtime": "按修改时间匹配，-N 表示 N 天内",
        "-exec": "对匹配结果执行命令"
      }
    },
    "ls": {
      "summary": "列出目录内容",
      "options": {
        "-l": "长格式",
        "-a": "包含隐藏文件",
        "-d": "显示目录本身",
        "-h": "人类可读大小"
      }
    },
    "chmod": {
      "summary": "修改文件或目录权限",
      "options": {
        "-R": "递归修改",
        "755": "所有者可读写执行，其他只读执行"
      }
    },
    "ps": {
      "summary": "查看进程快照",
      "options": {
        "aux": "显示所有用户的所有进程",
        "-ef": "另一种全量格式"
      }
    },
    "kill": {
      "summary": "向进程发送信号",
      "options": {
        "-9": "发送 SIGKILL 强制结束",
        "-15": "发送 SIGTERM 默认终止"
      }
    },
    "systemctl": {
      "summary": "管理 systemd 服务",
      "options": {
        "status": "查看服务状态",
        "start": "启动服务",
        "stop": "停止服务",
        "restart": "重启服务"
      }
    },
    "id": {
      "summary": "查看用户的 UID、GID 与所属组",
      "options": {
        "-u": "只显示 UID",
        "-g": "只显示 GID",
        "-n": "显示名称"
      }
    },
    "journalctl": {
      "summary": "查看 systemd 日志",
      "options": {
        "-p err": "只看错误级别",
        "-n 50": "显示最近 50 条",
        "-u": "限定服务"
      }
    },
    "ss": {
      "summary": "查看套接字与网络连接",
      "options": {
        "-t": "TCP",
        "-u": "UDP",
        "-l": "仅监听",
        "-n": "数字形式",
        "-p": "显示进程"
      }
    },
    "uname": {
      "summary": "显示系统信息",
      "options": {
        "-r": "内核版本",
        "-a": "全部信息",
        "-m": "硬件架构"
      }
    },
    "make": {
      "summary": "按 Makefile 构建项目",
      "options": {
        "-C": "切换到指定目录",
        "clean": "清理构建产物",
        "-j": "并行构建"
      }
    },
    "grep": {
      "summary": "按正则搜索文本",
      "options": {
        "-i": "忽略大小写",
        "-r": "递归目录",
        "-n": "显示行号",
        "-v": "反向匹配"
      }
    },
    "cat": {
      "summary": "连接并输出文件内容",
      "options": {
        "-n": "显示行号",
        "-A": "显示不可见字符"
      }
    },
    "tail": {
      "summary": "输出文件末尾内容",
      "options": {
        "-n": "指定行数",
        "-f": "持续跟踪"
      }
    },
    "head": {
      "summary": "输出文件开头内容",
      "options": {
        "-n": "指定行数"
      }
    },
    "mkdir": {
      "summary": "创建目录",
      "options": {
        "-p": "递归创建父目录",
        "-m": "指定权限"
      }
    },
    "cp": {
      "summary": "复制文件或目录",
      "options": {
        "-r": "递归复制目录",
        "-a": "保留属性",
        "-v": "显示过程"
      }
    },
    "mv": {
      "summary": "移动或重命名文件",
      "options": {
        "-i": "覆盖前询问",
        "-v": "显示过程"
      }
    },
    "rm": {
      "summary": "删除文件或目录",
      "options": {
        "-r": "递归删除目录",
        "-f": "强制不询问",
        "-i": "逐个确认"
      }
    },
    "chown": {
      "summary": "修改文件所有者与属组",
      "options": {
        "-R": "递归修改",
        "user:group": "同时指定用户和组"
      }
    },
    "tar": {
      "summary": "打包或解包归档文件",
      "options": {
        "-czf": "创建 gzip 压缩包",
        "-xzf": "解压 gzip 包",
        "-tf": "列出内容"
      }
    },
    "awk": {
      "summary": "按字段处理文本",
      "options": {
        "-F": "指定字段分隔符",
        "{print $1}": "输出第一列"
      }
    },
    "xargs": {
      "summary": "把标准输入转换为命令行参数",
      "options": {
        "-n": "每次最多传 N 个参数",
        "-0": "以 NUL 分隔输入",
        "-I": "用占位符替换参数",
        "-r": "无输入时不执行"
      }
    },
    "wc": {
      "summary": "统计行数、单词数和字节数",
      "options": {
        "-l": "只统计行数",
        "-w": "只统计单词数",
        "-c": "只统计字节数"
      }
    },
    "sort": {
      "summary": "对文本行排序",
      "options": {
        "-n": "按数值排序",
        "-r": "逆序",
        "-h": "按人类可读大小",
        "-u": "去重"
      }
    },
    "cut": {
      "summary": "按列截取文本",
      "options": {
        "-d": "指定分隔符",
        "-f": "指定字段"
      }
    },
    "uniq": {
      "summary": "去除相邻重复行",
      "options": {
        "-c": "统计出现次数",
        "-d": "只显示重复行",
        "-u": "只显示不重复行"
      }
    },
    "tee": {
      "summary": "把输入同时写到文件和标准输出",
      "options": {
        "-a": "追加而不是覆盖"
      }
    }
  }
}
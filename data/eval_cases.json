{
  "version": 1,
  "description": "离线解析评测集：15 个意图 × 2 条，共 30 条",
  "cases": [
    {"input": "查看磁盘使用情况", "intent": "disk_usage", "command": "df -h"},
    {"input": "磁盘还剩多少空间", "intent": "disk_usage", "command": "df -h"},
    {"input": "查看内核版本", "intent": "kernel_version", "command": "uname -r"},
    {"input": "当前内核是多少", "intent": "kernel_version", "command": "uname -r"},
    {"input": "查看目录大小", "intent": "dir_usage", "command": "du -sh ."},
    {"input": "看看 /var 的占用", "intent": "dir_usage", "command": "du -sh /var"},
    {"input": "找出 /var/log 下大于 100M 的文件", "intent": "large_files", "command": "find /var/log -type f -size +100M"},
    {"input": "查找 /home 下超过 1G 的大文件", "intent": "large_files", "command": "find /home -type f -size +1G"},
    {"input": "找出 /home 下 7 天内修改的 .c 文件", "intent": "recent_files", "command": "find /home -type f -name '*.c' -mtime -7"},
    {"input": "查看 /var/log 下最近 3 天修改过的 .log 文件", "intent": "recent_files", "command": "find /var/log -type f -name '*.log' -mtime -3"},
    {"input": "查找 /etc 下名为 sshd_config 的文件", "intent": "find_by_name", "command": "find /etc -type f -name 'sshd_config'"},
    {"input": "在 /usr/local 下查找名为 nginx.conf 的文件", "intent": "find_by_name", "command": "find /usr/local -type f -name 'nginx.conf'"},
    {"input": "查看 /tmp 的权限", "intent": "view_permissions", "command": "ls -ld /tmp"},
    {"input": "查看 /etc/passwd 的权限", "intent": "view_permissions", "command": "ls -ld /etc/passwd"},
    {"input": "把 /tmp/x 权限改成 777", "intent": "change_permissions", "command": "chmod 777 /tmp/x"},
    {"input": "将 /home/user/test.sh 权限设为 755", "intent": "change_permissions", "command": "chmod 755 /home/user/test.sh"},
    {"input": "查看当前进程", "intent": "process_list", "command": "ps aux"},
    {"input": "列出所有进程", "intent": "process_list", "command": "ps aux"},
    {"input": "结束进程 1234", "intent": "kill_process", "command": "kill -9 1234"},
    {"input": "杀掉进程 5678", "intent": "kill_process", "command": "kill -9 5678"},
    {"input": "查看 ssh 服务状态", "intent": "service_status", "command": "systemctl status ssh"},
    {"input": "查看 nginx 服务状态", "intent": "service_status", "command": "systemctl status nginx"},
    {"input": "查看用户 alice", "intent": "user_info", "command": "id alice"},
    {"input": "用户 root 的信息", "intent": "user_info", "command": "id root"},
    {"input": "查看系统日志错误", "intent": "log_errors", "command": "journalctl -p err -n 50"},
    {"input": "最近的报错", "intent": "log_errors", "command": "journalctl -p err -n 50"},
    {"input": "查看端口监听", "intent": "network_ports", "command": "ss -tulnp"},
    {"input": "看看网络连接", "intent": "network_ports", "command": "ss -tulnp"},
    {"input": "清理编译产物", "intent": "clean_build", "command": "make clean"},
    {"input": "清理当前目录的构建产物", "intent": "clean_build", "command": "make clean"}
  ]
}
